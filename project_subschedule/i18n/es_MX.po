msgid "Task"
msgstr "Tarea"

#. module: project_subschedule
#. odoo-python
#: code:addons/project_subschedule/models/project_task.py:0
msgid ""
"The %(stage)s subschedule is closed: %(tasks)s can only change through an "
"authorized change."
msgstr ""
"El subcronograma de %(stage)s está cerrado: %(tasks)s solo cambia con un "
"cambio autorizado."

#. module: project_subschedule
#: model:ir.model.fields,help:project_subschedule.field_project_task__effective_phase_id
msgid ""
"The stage of this task: its own or the one of its nearest marked grouping "
"task."
msgstr ""
"La etapa de esta tarea: la propia o la de su agrupadora marcada más cercana."

#. module: project_subschedule
#: model:ir.model.fields,help:project_subschedule.field_project_task__display_name
msgid ""
"Use these keywords in the title to set new tasks:\n"
"\n"
"            #tags Set tags on the task\n"
"            @user Assign the task to a user\n"
"            ! Set the task a medium priority\n"
"            !! Set the task a high priority\n"
"            !!! Set the task a urgent priority\n"
"\n"
"            Make sure to use the right format and order e.g. Improve the configuration screen #feature #v16 @Mitchell !"
msgstr ""
"Usa estas palabras clave en el título para configurar nuevas tareas:\n"
"\n"
"        30h Asigna 30 horas a la tarea\n"
"        #etiquetas Agrega etiquetas a la tarea\n"
"        @usuario Asígnale la tarea a un usuario\n"
"        ! Define que la prioridad de la tarea es media\n"
"        !! Define que la prioridad de la tarea es alta\n"
"        !!! Define que la prioridad de la tarea es urgente\n"
"\n"
"        Asegúrate de utilizar el formato y el orden correcto, por ejemplo: Realizar mejoras a la pantalla de configuración 5h #función #v16 @Mitchell !"
