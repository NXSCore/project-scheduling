#. module: project_subschedule
#: model:ir.model.fields,help:project_subschedule.field_project_task__phase_id
msgid ""
"Marks this task as the grouping task of a stage subschedule: its subtasks "
"belong to that stage."
msgstr ""
"Marca esta tarea como la agrupadora del subcronograma de una etapa: sus "
"subtareas pertenecen a esa etapa."

#. module: project_subschedule
#: model:ir.model.fields,field_description:project_subschedule.field_project_task__phase_id
