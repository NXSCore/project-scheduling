<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_schedule_health_view_form" model="ir.ui.view">
        <field name="name">project.schedule.health.form</field>
        <field name="model">project.schedule.health</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">The fourteen checks of the DCMA schedule assessment (DCMA-EA PAM 200.1): is the
                    schedule well built before it is approved as a baseline? Nothing is changed.</p>
                <group>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="status_date"/>
                    </group>
                    <group>
                        <field name="high_float_days"/>
                        <field name="high_duration_days"/>
                    </group>
                </group>
                <group invisible="not line_ids">
                    <group>
                        <field name="task_count"/>
                        <field name="link_count"/>
                    </group>
                    <group>
                        <field name="passed_count" decoration-success="1"/>
                        <field name="failed_count" decoration-danger="failed_count &gt; 0"/>
                    </group>
                </group>
                <field name="line_ids" invisible="not line_ids">
                    <list decoration-success="result == 'pass'" decoration-danger="result == 'fail'"
                          decoration-muted="result == 'na'" create="0" delete="0">
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="value"/>
                        <field name="threshold"/>
                        <field name="result" widget="badge" decoration-success="result == 'pass'"
                               decoration-danger="result == 'fail'"/>
                        <field name="task_count"/>
                        <button name="action_open_tasks" type="object" string="Tasks" icon="fa-list"
                                invisible="not task_count"/>
                    </list>
                </field>
                <footer>
                    <button name="action_check" type="object" string="Check" class="btn-primary"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_schedule_health_action" model="ir.actions.act_window">
        <field name="name">Schedule Health Check</field>
        <field name="res_model">project.schedule.health</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
