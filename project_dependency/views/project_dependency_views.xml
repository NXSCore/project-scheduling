<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_dependencies" model="ir.ui.view">
        <field name="name">project.task.form.typed.dependencies</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- El Gantt crea vínculos fin-a-inicio al arrastrar la flecha;
                 el TIPO y el desfase se cambian aquí (en Enterprise,
                 `project_dependency_gantt` añade además un selector en el
                 conector). -->
            <xpath expr="//notebook" position="inside">
                <!-- Todo lo del cronograma en una pestaña: EDT, duración,
                     tarea manual, restricción y fechas reales. -->
                <page string="Schedule" name="dependencies">
                    <group>
                        <group string="Plan" name="schedule_plan">
                            <field name="wbs_code"/>
                            <field name="duration_days"/>
                            <field name="is_milestone"/>
                            <field name="manually_scheduled"/>
                        </group>
                        <group string="Date Constraint" name="schedule_constraint">
                            <field name="constraint_type"/>
                            <field name="constraint_date" invisible="constraint_type in ('asap', 'alap', False)"
                                   required="constraint_type not in ('asap', 'alap', False)"/>
                            <field name="finish_deadline"/>
                        </group>
                        <group string="Actual Dates" name="schedule_actuals">
                            <field name="actual_start"/>
                            <field name="actual_finish"/>
                        </group>
                        <group string="Critical Path" name="schedule_critical">
                            <field name="is_critical" readonly="1"/>
                            <field name="total_float_days" readonly="1"/>
                            <field name="free_float_days" readonly="1"/>
                            <field name="early_finish" readonly="1"/>
                            <field name="late_finish" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Predecessors"/>
                    <field name="predecessor_link_ids" context="{'default_successor_id': id}">
                        <list editable="bottom">
                            <field name="predecessor_id"
                                   options="{'no_create': True}"/>
                            <field name="link_type"/>
                            <field name="lag_days"/>
                            <field name="lag_elapsed" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Successors"/>
                    <field name="successor_link_ids" context="{'default_predecessor_id': id}">
                        <list editable="bottom">
                            <field name="successor_id"
                                   options="{'no_create': True}"/>
                            <field name="link_type"/>
                            <field name="lag_days"/>
                            <field name="lag_elapsed" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_list_critical" model="ir.ui.view">
        <field name="name">project.task.list.critical.path</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <!-- La EDT al frente, como en MS Project, y la duración. -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="wbs_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="duration_days" optional="show"/>
                <field name="is_milestone" optional="hide"/>
                <field name="is_critical" optional="show"/>
                <field name="total_float_days" optional="show"/>
                <field name="free_float_days" optional="hide"/>
                <field name="finish_deadline" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="project_dependency_view_list" model="ir.ui.view">
        <field name="name">project.dependency.list</field>
        <field name="model">project.dependency</field>
        <field name="arch" type="xml">
            <list string="Dependencies" editable="bottom">
                <field name="predecessor_id" options="{'no_create': True}"/>
                <field name="successor_id" options="{'no_create': True}"/>
                <field name="link_type"/>
                <field name="lag_days"/>
                <field name="lag_elapsed"/>
            </list>
        </field>
    </record>

    <!-- El formulario que abre el botón del conector: lo mínimo que se está
         editando, sin el ruido del resto del modelo. -->
    <record id="project_dependency_view_form" model="ir.ui.view">
        <field name="name">project.dependency.form</field>
        <field name="model">project.dependency</field>
        <field name="arch" type="xml">
            <form string="Dependency">
                <group>
                    <field name="predecessor_id" readonly="1"/>
                    <field name="successor_id" readonly="1"/>
                    <field name="link_type"/>
                    <field name="lag_days"/>
                    <field name="lag_elapsed"/>
                </group>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- El calendario con el que se calcula el cronograma del proyecto. -->
    <record id="project_project_view_form_schedule_calendar" model="ir.ui.view">
        <field name="name">project.project.form.schedule.calendar</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']" position="inside">
                <group string="Scheduling" name="scheduling">
                    <field name="schedule_calendar_id"/>
                    <field name="minutes_per_day"/>
                    <field name="schedule_from"/>
                    <field name="project_finish" invisible="schedule_from != 'finish'" required="schedule_from == 'finish'"/>
                    <field name="honor_constraints"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
