<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_mspdi_import_wizard_view_form" model="ir.ui.view">
        <field name="name">project.mspdi.import.wizard.form</field>
        <field name="model">project.mspdi.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import from Microsoft Project">
                <field name="state" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p>In Microsoft Project use <b>File &gt; Save As &gt; XML Format (*.xml)</b> and upload that file here.</p>
                    <p class="text-muted">Tasks, hierarchy, dates, milestones, assignees and links (type and lag) are imported.
                        Importing the same file again updates the tasks instead of duplicating them; nothing is deleted.</p>
                    <group>
                        <field name="file" filename="filename" required="state == 'draft'"/>
                        <field name="calendar_mode" widget="radio"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <field name="summary" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_mspdi_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import from Microsoft Project</field>
        <field name="res_model">project.mspdi.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

    <!-- Portable. Botón en la ficha del proyecto de la app Proyectos. -->
    <record id="project_project_view_form_mspdi_import" model="ir.ui.view">
        <field name="name">project.project.form.mspdi.import</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_share_project_wizard']" position="after">
                <button name="%(project_msproject.project_mspdi_import_wizard_action)d"
                        type="action" string="Import from MS Project"
                        groups="project.group_project_user"/>
                <button name="action_export_mspdi" type="object" string="Export to MS Project"
                        groups="project.group_project_user"/>
            </xpath>
        </field>
    </record>

</odoo>
