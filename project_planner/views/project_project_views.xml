<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón «Planificador» en la ficha del proyecto: abre el planificador a
         pantalla completa con las tareas del proyecto. También en Community. -->
    <record id="project_project_view_form_planner" model="ir.ui.view">
        <field name="name">project.project.form.planner</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_planner" type="object" class="oe_stat_button" icon="fa-align-left"
                        string="Planner" groups="project.group_project_user"/>
            </xpath>
        </field>
    </record>
</odoo>
